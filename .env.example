# ==============================================================================
# Sameer Pandey Portfolio — Environment Configuration
# ==============================================================================
#
# To enable the Layer 2 AI Chatbot locally:
# 1. Copy this file to .env:
#      cp .env.example .env
# 2. Add your Groq API key below.
#
# Obtain a free Groq API key at:
#   https://console.groq.com/keys
#
# ------------------------------------------------------------------------------
# GROQ_API_KEY
# ------------------------------------------------------------------------------
# Used by:
#  - Local Dev Server: Vite localChatApiPlugin (proxying /api/chat)
#  - Production: Netlify Serverless Function (netlify/functions/chat.js)
#
# Note:
#  - If this key is not set, the site still works completely:
#    * Layer 1 Instant Matcher resolves all predefined project, skill, and bio queries.
#    * Layer 2 politely indicates that demo mode is active without throwing errors.
#
GROQ_API_KEY=gsk_your_groq_api_key_here
